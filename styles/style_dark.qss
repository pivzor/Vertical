/* =========================================================
   DARK THEME
========================================================= */

QMainWindow,
QDialog,
QWidget {
    background-color: #111827;
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 17px;
    font-weight: 500;
}

/* =========================================================
   CARDS
========================================================= */

QFrame#card {
    background-color: #1f2937;
    border: 1px solid #2c3747;
    border-radius: 20px;
}

/* =========================================================
   LABELS
========================================================= */

QLabel {
    color: #f3f4f6;
    background: transparent;
    border: none;
    font-size: 17px;
    font-weight: 500;
}

/* =========================================================
   TITLES
========================================================= */

.title-main {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
}

.title-card {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
}

.title-metrics {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
}

/* =========================================================
   VALUES
========================================================= */

.value-large {
    font-size: 52px;
    font-weight: 800;
}

.value-medium {
    font-size: 30px;
    font-weight: 700;
}

.value-score {
    font-size: 64px;
    font-weight: 900;
}

/* =========================================================
   TEXT
========================================================= */

.label-small {
    font-size: 15px;
    font-weight: 500;
    color: #9ca3af;
}

.label-metrics {
    font-size: 17px;
    font-weight: 600;
    color: #d1d5db;
}

/* =========================================================
   BUTTONS
========================================================= */

QPushButton {
    background-color: #374151;
    color: #f9fafb;
    border: 1px solid #4b5563;
    border-radius: 14px;
    padding: 14px 24px;
    font-size: 17px;
    font-weight: 700;
    min-height: 52px;
}

QPushButton:hover {
    background-color: #4b5563;
}

QPushButton:pressed {
    background-color: #2f3947;
}

QPushButton:disabled {
    background-color: #1f2937;
    color: #6b7280;
    border: 1px solid #374151;
}

/* =========================================================
   INPUTS
========================================================= */

QLineEdit,
QComboBox {
    background-color: #111827;
    border: 1px solid #374151;
    border-radius: 14px;
    padding: 12px 16px;
    min-height: 30px;
    color: #f3f4f6;
    font-size: 17px;
    font-weight: 600;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #64748b;
}

/* =========================================================
   TABS
========================================================= */

QTabWidget::pane {
    border: 1px solid #2c3747;
    border-radius: 16px;
    background-color: #1f2937;
}

QTabBar::tab {
    background-color: #243041;
    color: #d1d5db;
    padding: 14px 24px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    margin-right: 6px;
    font-size: 16px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #374151;
    color: white;
}

QTabBar::tab:hover {
    background-color: #324154;
}

/* =========================================================
   SLIDER
========================================================= */

QSlider::groove:horizontal {
    height: 10px;
    border-radius: 5px;
    background: #243041;
}

QSlider::sub-page:horizontal {
    background: #64748b;
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: #94a3b8;
    width: 24px;
    margin: -7px 0;
    border-radius: 12px;
}

/* =========================================================
   PROGRESS
========================================================= */

QProgressBar {
    background-color: #243041;
    border-radius: 12px;
    text-align: center;
    min-height: 30px;
    font-size: 16px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #64748b;
    border-radius: 12px;
}

/* =========================================================
   VIDEO
========================================================= */

#videoContainer {
    background-color: #0f172a;
    border-radius: 20px;
    border: 1px solid #2c3747;
}

/* =========================================================
   STATUS
========================================================= */

.status-active {
    color: #4ade80;
    font-size: 18px;
    font-weight: 800;
}

.status-inactive {
    color: #9ca3af;
    font-size: 18px;
    font-weight: 800;
}