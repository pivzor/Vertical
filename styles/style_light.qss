/* =========================================================
   LIGHT THEME
========================================================= */

QMainWindow,
QDialog,
QWidget {
    background-color: #f4f6f8;
    color: #111827;
    font-family: "Segoe UI";
    font-size: 17px;
    font-weight: 500;
}

/* =========================================================
   CARDS
========================================================= */

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #dbe2ea;
    border-radius: 20px;
}

/* =========================================================
   LABELS
========================================================= */

QLabel {
    color: #111827;
    background: transparent;
    border: none;
    font-size: 17px;
    font-weight: 500;
}

/* =========================================================
   TITLES
========================================================= */

.title-main {
    font-size: 38px;
    font-weight: 800;
}

.title-card {
    font-size: 28px;
    font-weight: 700;
}

.title-metrics {
    font-size: 26px;
    font-weight: 800;
}

/* =========================================================
   VALUES
========================================================= */

.value-large {
    font-size: 52px;
    font-weight: 800;
}

.value-medium {
    font-size: 30px;
    font-weight: 700;
}

.value-score {
    font-size: 96px;
    font-weight: 900;
}

/* =========================================================
   TEXT
========================================================= */

.label-small {
    font-size: 15px;
    font-weight: 500;
    color: #6b7280;
}

.label-metrics {
    font-size: 17px;
    font-weight: 600;
    color: #374151;
}

/* =========================================================
   BUTTONS
========================================================= */

QPushButton {
    background-color: #475569;
    color: white;
    border: none;
    border-radius: 14px;
    padding: 14px 24px;
    font-size: 17px;
    font-weight: 700;
    min-height: 52px;
}

QPushButton:hover {
    background-color: #5b6b7f;
}

QPushButton:pressed {
    background-color: #3d4a5c;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #64748b;
}

/* =========================================================
   INPUTS
========================================================= */

QLineEdit,
QComboBox {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px 16px;
    min-height: 30px;
    font-size: 17px;
    font-weight: 600;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #64748b;
}

/* =========================================================
   TABS
========================================================= */

QTabWidget::pane {
    border: 1px solid #dbe2ea;
    border-radius: 16px;
    background-color: white;
}

QTabBar::tab {
    background-color: #e8edf3;
    color: #475569;
    padding: 14px 24px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    margin-right: 6px;
    font-size: 16px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #475569;
    color: white;
}

/* =========================================================
   SLIDER
========================================================= */

QSlider::groove:horizontal {
    height: 10px;
    border-radius: 5px;
    background: #dbe2ea;
}

QSlider::sub-page:horizontal {
    background: #64748b;
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: #475569;
    width: 24px;
    margin: -7px 0;
    border-radius: 12px;
}

/* =========================================================
   PROGRESS
========================================================= */

QProgressBar {
    background-color: #e5e7eb;
    border-radius: 12px;
    text-align: center;
    min-height: 30px;
    font-size: 16px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #64748b;
    border-radius: 12px;
}

/* =========================================================
   VIDEO
========================================================= */

#videoContainer {
    background-color: #e2e8f0;
    border-radius: 20px;
    border: 1px solid #cbd5e1;
}

/* =========================================================
   STATUS
========================================================= */

.status-active {
    color: #16a34a;
    font-size: 18px;
    font-weight: 800;
}

.status-inactive {
    color: #64748b;
    font-size: 18px;
    font-weight: 800;
}

.posture-status {
    font-size: 28px;
    font-weight: 800;
    border-radius: 14px;
    padding: 10px;
}